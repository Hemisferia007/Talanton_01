# Copiar a .env y completar. El .env NO se commitea.
#
# Generar los secretos:
#   TALANTON_SECRET_KEY:     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   TALANTON_SESSION_SECRET: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   POSTGRES_PASSWORD:       python3 -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_PASSWORD=

# Cifra los refresh tokens de Gmail. Si se pierde, hay que reconectar las
# casillas. Si cambia, lo guardado deja de poder descifrarse.
TALANTON_SECRET_KEY=

# Firma la cookie de sesión. Si cambia, se cierran todas las sesiones abiertas.
TALANTON_SESSION_SECRET=

# 1 cuando la app se sirve por HTTPS. Dejarlo en 0 sólo en desarrollo local:
# con 0, la cookie de sesión viaja también por HTTP.
TALANTON_COOKIES_SEGURAS=1

# Gmail. Alta paso a paso en docs/gmail.md.
TALANTON_GOOGLE_CLIENT_ID=
TALANTON_GOOGLE_CLIENT_SECRET=
# Tiene que coincidir exactamente con la URI cargada en Google Cloud.
TALANTON_OAUTH_REDIRECT_URI=https://crm.talanton.com.ar/oauth/google/callback

# Tope de envíos por casilla y por día. No conviene subirlo: ver docs/gmail.md.
TALANTON_LIMITE_ENVIOS_DIARIOS=40

# Hora UTC de la corrida diaria de ingesta. 09 UTC ≈ 06:00 en Argentina.
HORA_INGESTA=09

PUERTO=8000

# Primer usuario, para hostings sin consola (Railway y similares). Sólo actúa si
# la tabla de usuarios está vacía. Borrar estas variables apenas se pudo entrar.
TALANTON_ADMIN_EMAIL=
TALANTON_ADMIN_PASSWORD=
TALANTON_ADMIN_NOMBRE=
